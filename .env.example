# =====================================================================
# TripAI configuration. Copy to .env and fill in what you have.
# With no keys at all, TripAI runs in DEMO MODE (sample Gurugram → Jaipur data).
# =====================================================================

# --- App ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database ------------------------------------------------------------
# PostgreSQL (recommended). docker-compose overrides this for the backend container.
DATABASE_URL=postgresql+psycopg://tripai:tripai@localhost:5432/tripai
# Quick start without PostgreSQL:
# DATABASE_URL=sqlite:///./tripai.db
POSTGRES_PASSWORD=tripai

# --- Auth ----------------------------------------------------------------
# Required in production: at least 32 random characters (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-only-change-me-please-32-characters-min
ACCESS_TOKEN_MINUTES=10080

# --- Mode ----------------------------------------------------------------
# auto  = use real providers where keys exist, sample data elsewhere
# true  = sample data only, no network calls (the Gurugram → Jaipur demo)
# false = like auto, but warn at startup if the Google key is missing
DEMO_MODE=auto

# --- LLM (explanations, intent parsing; never used for prices or times) ----
# auto picks openrouter if OPENROUTER_API_KEY is set, else openai_compatible if OPENAI_COMPAT_BASE_URL is set, else built-in templates
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Self-hosted OpenAI-compatible server, e.g. vLLM serving Qwen:
#   vllm serve Qwen/Qwen2.5-32B-Instruct --port 8001
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=Qwen/Qwen2.5-32B-Instruct
LLM_TIMEOUT_SECONDS=45

# --- Google Maps Platform (server-side only) ------------------------------
# Enable: Places API (New), Routes API, Geocoding API
GOOGLE_MAPS_SERVER_KEY=

# --- Web verification ------------------------------------------------------
WEB_SEARCH_PROVIDER=auto           # auto | brave | serper | tavily | none
WEB_SEARCH_API_KEY=
WEB_VERIFY_MAX_PLACES=6

# --- Real flights (ADR 0020) ---------------------------------------------------
# Google Flights through SerpApi (serpapi.com; the free plan has 250 searches a month, two per planned trip).
# Empty: flights stay estimated (no flight name, number or exact time).
SERPAPI_API_KEY=

# --- Optional providers ------------------------------------------------------
WEATHER_PROVIDER=auto              # auto (Open-Meteo, no key) | none
HOTEL_PROVIDER=auto                # auto | places | estimate

# --- Plans and payments --------------------------------------------------------
FREE_TRIP_PLANS=7                  # lifetime, per account
MAX_REPLANS_PER_TRIP=40
PAYMENTS_MODE=mock                 # mock (test checkout, nothing charged) | disabled
PLUS_PRICE_INR=99
ONE_TRIP_PRICE_INR=49

# --- Sign-up verification (email + mobile codes) -------------------------------
# Without these, codes are written to the backend log and (outside production) shown on the sign-up page
# in a 'Test mode' note. In production, a missing provider refuses to send instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Yaitro <no-reply@example.com>
# auto = twilio if its three values are set, else fast2sms if its key is set, else console (test mode)
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Fast2SMS: Indian (+91) numbers only, OTP route
FAST2SMS_API_KEY=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# --- Protection ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PLAN_PER_MINUTE=6
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Frontend (build-time; baked into the browser bundle) ------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional browser key for the Map tab. Restrict it to your domain (HTTP referrer).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Plan execution and data layer (ADR 0008) ------------------------------------
# Plans run in a bounded runner; extra plans wait in order ("High demand - you're #N" with an estimate from recent real plan times).
MAX_CONCURRENT_PLANS=12          # per process; keep below the Google bulkhead (16)
PLAN_QUEUE_LIMIT=40              # waiting past this: the "High demand" screen
PLAN_QUEUE_HARD_LIMIT=100        # waiting past this: new FREE plans are politely refused (replans and paid plans still enter)
LANE_MAX_WAIT_SECONDS=120        # a waiting plan is treated as first-lane after this long
PLAN_JOBS_ENABLED=true           # false: the old behaviour (a thread per request, no job rows)
REAPER_STALE_SECONDS=180         # a plan whose process stopped heartbeating this long ago is re-run once or refunded
# Brownout, set live (no restart): 0 off | 1 simpler text | 2 no alternatives | 3 fewer options compared | 4 saved rail timetables only
BROWNOUT_LEVEL=0
BROWNOUT_AUTO=false              # interface only: the suggested level is shown in /api/system/plans, never applied
# Redis is optional and free as a container (docker compose --profile redis up). Unset = everything runs in-process.
REDIS_URL=
CACHE_LRU_ENTRIES=0              # in-process cache tier in front of the database cache; 0 = off
CACHE_REDIS_ENABLED=false
CACHE_TTL_OVERRIDES=             # JSON, seconds, e.g. {"google-routes": 3600}; Google entries are capped at 7 days
PREWARM_ENABLED=false            # nightly refresh of the saved timetables nearest to expiry
# Server (gunicorn in Docker; Windows dev uses uvicorn)
WEB_CONCURRENCY=2
WORKER_TIMEOUT=120
GRACEFUL_TIMEOUT=30
DB_POOL_SIZE=                    # empty: MAX_CONCURRENT_PLANS + 6 per worker
DB_MAX_OVERFLOW=
POSTGRES_MAX_CONNECTIONS=100     # what your PostgreSQL allows; a startup warning fires if workers x pool is too close
BACKUP_RETENTION_DAYS=14

# --- Admin views and abuse limits (hotfix 2026-10-07) ----------------------------
# Who may open /api/system/plans, /budgets and /rail-stats (everyone else gets a 404). Put your own address in your local .env only.
ADMIN_EMAILS=admin@example.com
# Our OWN reverse proxies (comma-separated IPs or networks). Empty = X-Forwarded-For is never believed, which is right unless you run behind
# a proxy; behind one, list its address here or every visitor will look like the proxy. Never put * here.
TRUSTED_PROXY_IPS=
# Verification codes (sign-up): Indian mobile numbers only; limits are counted per number, per address and per day.
OTP_PER_PHONE_HOUR=3
OTP_PER_PHONE_DAY=5
OTP_PER_IP_HOUR=10               # 0 = no limit
SMS_DAILY_LIMIT=50               # paid text messages a day (0 = no cap); at the cap people get a calm message
KILL_SMS=false                   # true = stop sending texts now (set live in the environment; no code change)
